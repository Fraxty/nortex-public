// Baubar: nortexc build examples\language\02_math_and_overflows
// Mit overflow_checks = true trapt add(2147483647, 1): Exitcode 0xC000001D (-1073741795).
// Zum Vergleich: --overflow-checks=false baut ohne Trap (Wrap-around).
public int add(int a, int b)
{
    return a + b;
}

public int main()
{
    int ok = add(40, 2);
    if (ok != 42)
    {
        return 1;
    }
    int boom = add(2147483647, 1);
    return 0;
}

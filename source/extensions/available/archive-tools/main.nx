using System;
using sdk;

// Menüaktion "Projekt als .nxpack packen": höchstens 200 Dateien (Grenze der IDE);
// die IDE schreibt ein echtes ZIP mit Deflate und prüft Pfade, Symlinks und Größen.
public string pack_project() {
    string listing = sdk_project_files();
    if (Text.length(listing) == 0) { return "keine Projektdateien gefunden"; }
    StringList files = Text.split(listing, "\n");
    int total = StringList.length(files);
    mut string chosen = "";
    mut int count = 0;
    mut int i = 0;
    while (i < total && count < 200) {
        string path = StringList.get(files, i);
        if (Text.length(path) > 0) {
            chosen = chosen + path + "\n";
            count += 1;
        }
        i += 1;
    }
    StringList.free(files);
    string response = sdk_create_archive("projekt.nxpack", chosen + "", false);
    if (sdk_failed(response + "")) {
        return "FEHLER: " + sdk_error_message(response + "");
    }
    mut string note = "";
    if (total > count) { note = " (Limit: " + Convert.toString(count) + " von " + Convert.toString(total) + " Dateien)"; }
    return "projekt.nxpack (ZIP, Deflate) mit " + Convert.toString(sdk_int_field(response + "", "entries")) + " Dateien erstellt" + note + ".";
}

public int main() {
    if (!sdk_init_actions("Archive Tools", "1.1.0", "[{\"id\":\"pack-project\",\"title\":\"Projekt als .nxpack packen\"}]")) { return 1; }
    mut int guard = 0;
    while (guard < 100000) {
        string line = sdk_wait_action();
        if (Text.length(line) == 0) { return 0; }
        int id = sdk_int_field(line + "", "id");
        if (sdk_string_field(line + "", "action") == "pack-project") {
            string outcome = pack_project();
            if (Text.startsWith(outcome + "", "FEHLER: ")) {
                sdk_action_failed(id, outcome + "");
            } else {
                sdk_action_done(id, "Archive Tools: " + outcome);
            }
        } else {
            sdk_action_failed(id, "unbekannte Aktion");
        }
        guard += 1;
    }
    return 0;
}
using System;
using sdk;

public int count_of(string text, string part) {
    StringList pieces = Text.split(text, part);
    int found = StringList.length(pieces) - 1;
    StringList.free(pieces);
    return found;
}

public int main() {
    if (!sdk_init("Compiler Tools", "1.0.0")) { return 1; }
    string source = sdk_active_text();
    if (Text.length(source) == 0) {
        sdk_notify("Compiler Tools: kein vollständig lesbares Dokument aktiv.");
        sdk_wait_shutdown();
        return 0;
    }
    int lines = count_of(source + "", "\n");
    int imports = count_of(source + "", "using ");
    int functions = count_of(source + "", "public ") - count_of(source + "", "public class");
    string report = sdk_call("diagnostics.active", "{}");
    int errors = count_of(report + "", "\"severity\":\"error\"");
    int warnings = count_of(report + "", "\"severity\":\"warning\"");
    sdk_notify("Compiler Tools: " + Convert.toString(lines) + " Zeilen, " + Convert.toString(imports) + " using, " + Convert.toString(functions) + " öffentliche Deklarationen, " + Convert.toString(errors) + " Fehler, " + Convert.toString(warnings) + " Warnungen.");
    sdk_wait_shutdown();
    return 0;
}

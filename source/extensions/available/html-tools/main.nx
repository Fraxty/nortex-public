using System;
using sdk;

public int count_of(string text, string part) {
    StringList pieces = Text.split(text, part);
    int found = StringList.length(pieces) - 1;
    StringList.free(pieces);
    return found;
}

public int main() {
    if (!sdk_init("HTML Tools", "1.0.0")) { return 1; }
    string source = Text.toLower(sdk_active_text());
    if (Text.length(source) == 0) {
        sdk_notify("HTML Tools: kein vollständig lesbares Dokument aktiv.");
        sdk_wait_shutdown();
        return 0;
    }
    mut string problems = "";
    if (!Text.contains(source, "<title")) { problems = problems + " <title> fehlt;"; }
    if (!Text.contains(source, "<html")) { problems = problems + " <html> fehlt;"; }
    int images = count_of(source + "", "<img");
    int withAlt = count_of(source + "", " alt=");
    if (withAlt < images) { problems = problems + " " + Convert.toString(images - withAlt) + " <img> ohne alt;"; }
    int opens = count_of(source + "", "<div");
    int closes = count_of(source + "", "</div>");
    if (opens != closes) { problems = problems + " <div> offen/zu: " + Convert.toString(opens) + "/" + Convert.toString(closes) + ";"; }
    int headings = count_of(source + "", "<h1") + count_of(source + "", "<h2") + count_of(source + "", "<h3");
    if (Text.length(problems) == 0) {
        sdk_notify("HTML Tools: keine Probleme, " + Convert.toString(headings) + " Überschriften, " + Convert.toString(images) + " Bilder.");
    } else {
        sdk_notify("HTML Tools:" + problems);
    }
    sdk_wait_shutdown();
    return 0;
}

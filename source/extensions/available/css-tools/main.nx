using System;
using sdk;

public int count_of(string text, string part) {
    StringList pieces = Text.split(text, part);
    int found = StringList.length(pieces) - 1;
    StringList.free(pieces);
    return found;
}

public int main() {
    if (!sdk_init("CSS Tools", "1.0.0")) { return 1; }
    string source = sdk_active_text();
    if (Text.length(source) == 0) {
        sdk_notify("CSS Tools: kein vollständig lesbares Dokument aktiv.");
        sdk_wait_shutdown();
        return 0;
    }
    int opens = count_of(source + "", "{");
    int closes = count_of(source + "", "}");
    int important = count_of(source + "", "!important");
    int colors = count_of(source + "", "#");
    if (opens != closes) {
        sdk_notify("CSS Tools: geschweifte Klammern unausgeglichen (" + Convert.toString(opens) + " offen, " + Convert.toString(closes) + " zu).");
    } else {
        sdk_notify("CSS Tools: " + Convert.toString(opens) + " Regeln, " + Convert.toString(important) + " x !important, " + Convert.toString(colors) + " Farbwerte.");
    }
    sdk_wait_shutdown();
    return 0;
}
